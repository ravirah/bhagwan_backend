# Server Configuration
PORT=5000
NODE_ENV=development

# Database Type: mongodb | mysql | postgres | sqlite
DB_TYPE=mongodb

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ram-counter

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ram_counter

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=ram_counter

# SQLite Configuration
SQLITE_PATH=./database.sqlite

# Authentication
JWT_SECRET=your_jwt_secret_key_change_this_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQL sync mode: safe | alter | force | none
# PRODUCTION MUST be 'safe' (create-missing-tables only). 'alter' can rewrite/drop columns and
# 'force' DROPs every table — never use them against real data. Schema changes go through an
# explicit migration script (see scripts/migrate-*.js). 'alter' is for local dev only.
DB_SYNC_MODE=safe

